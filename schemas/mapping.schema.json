{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CriminalLawMapping",
  "description": "Schema for IPC↔BNS, CrPC↔BNSS, and IEA↔BSA transition crosswalk mappings",
  "type": "object",
  "required": ["old_act_id", "old_section", "new_act_id", "new_section", "mapping_type"],
  "properties": {
    "old_act_id": {
      "type": "string",
      "pattern": "^A[0-9]{4}-[0-9]+$"
    },
    "old_section": {
      "type": ["string", "null"],
      "description": "Null for a provision new in the 2023 code (mapping_type new_provision)"
    },
    "new_act_id": {
      "type": "string",
      "pattern": "^A[0-9]{4}-[0-9]+$"
    },
    "new_section": {
      "type": ["string", "null"],
      "description": "Null for a provision with no successor (mapping_type repealed)"
    },
    "mapping_type": {
      "type": "string",
      "enum": ["direct", "split", "merged", "modified", "new_provision", "repealed"]
    },
    "notes": {
      "type": ["string", "null"]
    },
    "effective_from": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "description": "ISO date the new code commenced (2024-07-01 for BNS, BNSS and BSA)"
    },
    "applies_by": {
      "type": "string",
      "enum": ["offence_date", "proceeding_date"],
      "description": "offence_date for BNS (substantive law, Art. 20(1)); proceeding_date for BNSS (s. 531) and BSA (s. 170)"
    }
  },
  "allOf": [
    {
      "if": {"properties": {"mapping_type": {"const": "new_provision"}}},
      "then": {"properties": {"old_section": {"type": "null"}, "new_section": {"type": "string"}}}
    },
    {
      "if": {"properties": {"mapping_type": {"const": "repealed"}}},
      "then": {"properties": {"old_section": {"type": "string"}, "new_section": {"type": "null"}}}
    },
    {
      "if": {"properties": {"mapping_type": {"enum": ["direct", "split", "merged", "modified"]}}},
      "then": {"properties": {"old_section": {"type": "string"}, "new_section": {"type": "string"}}}
    }
  ]
}
